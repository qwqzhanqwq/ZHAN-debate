// Windows executable icon and version info (generated by CMake)
#include <winver.h>

IDI_ICON1 ICON "@ZHAN_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "qwqzhanqwq"
            VALUE "FileDescription",  "ZHAN Debate Timer"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "zhan-debate"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "zhan-debate.exe"
            VALUE "ProductName",      "ZHAN Debate"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
